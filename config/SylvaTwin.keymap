#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        task {
            bindings = <&kp LG(TAB)>;
            key-positions = <6 7>;
        };

        RightClick {
            bindings = <&mkp RCLK>;
            key-positions = <15 16>;
        };

        MiddleClick {
            bindings = <&mkp MCLK>;
            key-positions = <3 15>;
        };

        LeftClick {
            bindings = <&mkp LCLK>;
            key-positions = <14 15>;
        };

        MiddleClick2 {
            bindings = <&mkp MCLK>;
            key-positions = <31 45>;
        };

        zen-han {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <42 28>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <41 27>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <40 26>;
        };

        prev_click {
            bindings = <&mkp MB4>;
            key-positions = <16 14>;
        };
    };

    macros {
        hokuden: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(D) &kp N1 &kp MINUS &kp N2 &kp N1 &kp N1>,
                <&macro_press>;

            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp Q     &kp W     &kp E  &kp R    &kp T                                          &kp Y        &kp U  &kp I      &kp O            &kp L      &kp LG(D)
&kp TAB     &kp A     &kp S     &kp D  &kp F    &kp G                                          &kp H        &kp J  &kp K      &kp P            &kp MINUS  &kp BACKSPACE
&kp LSHIFT  &kp Z     &kp X     &kp C  &kp V    &kp B        &mkp LCLK         &mkp LCLK       &kp N        &kp M  &kp COMMA  &kp DOT          &kp UP     &kp RSHIFT
&kp LCTRL   &kp LGUI  &kp LALT  &none  &kp DEL  &lt 1 SPACE  &kp INT_MUHENKAN  &kp INT_HENKAN  &lt 2 ENTER  &none  &none      &kp LC(LS(TAB))  &kp DOWN   &kp LC(TAB)
            >;

            sensor-bindings = <&inc_dec_kp C_AC_SCROLL_DOWN C_AC_SCROLL_UP>;
        };

        layer_1 {
            bindings = <
&kp EXCLAMATION  &kp QUESTION  &trans          &kp UP_ARROW    &trans           &kp COLON                               &none                  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS      &none
&trans           &trans        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LEFT_PARENTHESIS                    &kp RIGHT_PARENTHESIS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS     &kp BACKSPACE
&trans           &trans        &trans          &trans          &trans           &trans                &trans  &trans    &none                  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK  &kp BSLH
&trans           &trans        &trans          &trans          &trans           &none                 &none   &hokuden  &kp ENTER              &kp NUMBER_0  &kp COMMA     &kp PERIOD    &none         &kp INTERNATIONAL_1
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&none         &none         &kp F2        &kp F3        &kp F4        &kp F5                              &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&none         &kp F6        &kp F7        &kp F8        &kp F9        &kp F10                             &mkp MCLK  &trans     &trans  &trans  &trans  &trans
&none         &kp F11       &kp F12       &none         &none         &none       &none           &trans  &trans     &trans     &trans  &trans  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR  &studio_unlock  &trans  &trans     &trans     &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_DEC C_BRIGHTNESS_INC>;
        };
    };
};
