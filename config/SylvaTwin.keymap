#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        task {
            bindings = <&kp LG(TAB)>;
            key-positions = <6 7>;
        };

        RightClick {
            bindings = <&mkp RCLK>;
            key-positions = <15 16>;
        };

        MiddleClick {
            bindings = <&mkp MCLK>;
            key-positions = <3 15>;
        };

        LeftClick {
            bindings = <&mkp LCLK>;
            key-positions = <14 15>;
        };

        MiddleClick2 {
            bindings = <&mkp MCLK>;
            key-positions = <31 45>;
        };

        zen-han {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        paste {
            bindings = <&none>;
            key-positions = <16 4>;
        };

        copy {
            bindings = <&none>;
            key-positions = <14 2>;
        };

        redo {
            bindings = <&kp LC(Z)>;
            key-positions = <11 10>;
        };

        prev_click {
            bindings = <&mkp MB4>;
            key-positions = <45 6>;
        };
    };

    macros {
        hokuden: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(D) &kp N1 &kp MINUS &kp N2 &kp N1 &kp N1>,
                <&macro_press>;

            label = "NEW_MACRO";
        };

        surassyu: surassyu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&macro_press>;

            label = "SURASSYU";
        };

        ikooru: ikooru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>;
            label = "IKOORU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC        &kp Q     &kp W     &kp E  &kp R                &kp T                              &kp Y        &kp U                &kp I      &kp O            &kp L      &kp LG(D)
&mt LCTRL TAB  &kp A     &kp S     &kp D  &kp F                &kp G                              &kp H        &kp J                &kp K      &kp P            &kp MINUS  &kp BACKSPACE
&kp LSHIFT     &kp Z     &kp X     &kp C  &kp V                &kp B        &mkp LCLK  &mkp LCLK  &kp N        &kp M                &kp COMMA  &kp DOT          &kp UP     &kp RSHIFT
&kp DEL        &kp LGUI  &kp LALT  &none  &kp INTERNATIONAL_5  &lt 1 SPACE  &kp LC(C)  &kp LC(V)  &lt 2 ENTER  &kp INTERNATIONAL_4  &none      &kp LC(LS(TAB))  &kp DOWN   &kp LC(TAB)
            >;

            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
        };

        layer_1 {
            bindings = <
&kp EXCLAMATION  &kp QUESTION  &trans          &kp UP_ARROW    &trans           &kp COLON                               &none                  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS      &ikooru
&trans           &trans        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LEFT_PARENTHESIS                    &kp RIGHT_PARENTHESIS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS     &kp BACKSPACE
&trans           &trans        &trans          &trans          &trans           &trans                &trans  &trans    &none                  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp ASTERISK  &surassyu
&trans           &trans        &trans          &trans          &trans           &none                 &none   &hokuden  &kp ENTER              &kp KP_NUMBER_0  &kp COMMA        &kp PERIOD       &none         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&none  &none    &kp F2   &kp F3  &kp F4  &kp F5                           &mkp LCLK  &mkp RCLK  &kp F8  &trans  &trans  &bt BT_SEL 0
&none  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10                          &mkp MCLK  &kp F4     &kp F5  &kp F6  &trans  &bt BT_SEL 1
&none  &kp F11  &kp F12  &none   &none   &none    &none           &trans  &trans     &trans     &kp F2  &kp F3  &trans  &bt BT_SEL 2
&none  &none    &none    &none   &none   &none    &studio_unlock  &trans  &trans     &trans     &trans  &trans  &trans  &bt BT_SEL 3
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };
    };
};
